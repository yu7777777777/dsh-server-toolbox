{
  "name": "@local/dsh-server-toolbox",
  "version": "1.3.0-beta.2",
  "dependencies": { "ssh2": "1.17.0" },
  "scripts": { "test": "node test.mjs && node integration-test.mjs" },
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Manage SSH servers and deployed services by name and access URL in DSH.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "application.js", "secrets.js", "ssh.js", "tools.js", "transport.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-connection"]
    }
  }
}
